# infra/compose.yml 用。cp .env.example .env して値を埋める（infra/.env はコミットしない）
# 秘密情報の作り方: docs/20260922_1716_ローカルdocker-compose検証手順.md §3 手順0

# --- 秘密情報 ---
POSTGRES_PASSWORD=
JWT_SECRET=
# JWT_SECRET で署名した HS256 の JWT（role: anon / service_role）
ANON_KEY=
SERVICE_ROLE_KEY=

# --- URL ---
# アプリから見た Supabase の URL（= nginx）。アプリの SUPABASE_URL / NEXT_PUBLIC_SUPABASE_URL と同じ値
SUPABASE_PUBLIC_URL=http://127.0.0.1:8000
# 以下は supabase/config.toml の [auth] site_url / additional_redirect_urls と同じ値。
# admin の /update-password は招待・パスワード再設定メールのリンク先。ここに無いとリンクが web（SITE_URL）に飛ぶ
SITE_URL=http://127.0.0.1:3004
ADDITIONAL_REDIRECT_URLS=https://127.0.0.1:3004,http://127.0.0.1:3003/update-password,http://localhost:3003/update-password

# --- メール（SMTP）---
# 管理画面の招待・パスワード再設定のメールを送る。SMTP_HOST が空なら送らない（GoTrue はログに出すだけ）
# 手順: docs/20260930_2104_さくらVPS構築手順.md 手順13
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=noreply@ezocivic.tech
SMTP_SENDER_NAME=EZO CIVIC

# --- 設定 ---
JWT_EXPIRY=3600
# 匿名サインインの上限（1時間あたり・IP ごと）
RATE_LIMIT_ANONYMOUS_USERS=30

# --- ホストに公開するポート（127.0.0.1 のみ）---
GATEWAY_PORT=8000
DB_PORT=5433
